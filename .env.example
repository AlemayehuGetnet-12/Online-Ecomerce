# Server environment variables
# Copy this file to server/.env and fill in the values

# Server port (optional, defaults to 5000)
PORT=5000

# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# JWT secret for token signing (use a strong random string in production)
JWT_SECRET=your_jwt_secret_here

# Client URL(s) - comma-separated list of allowed origins for CORS
# In production, set this to your deployed frontend URL
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development