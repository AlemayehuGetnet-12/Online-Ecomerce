# Environment Variables for Vercel Deployment
# Set these in Vercel → Settings → Environment Variables

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/alexdb?retryWrites=true&w=majority

# JWT secret for token signing
JWT_SECRET=alex-store-super-secret-jwt-key-2024-change-in-production

# JWT expiry
JWT_EXPIRE=30d

# Node environment
NODE_ENV=production

# Optional: If using a separate backend, set this to the backend URL
# If not set, the app uses relative /api paths (works with Vercel serverless functions)
# VITE_API_URL=https://your-backend-url.onrender.com