# ─── Server Environment Variables ────────────────────────────────────────────
# Copy to server/.env and fill in real values before running

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/alexdb?retryWrites=true&w=majority

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 32+ random characters. Never use this placeholder in production.
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX_STRING

# JWT expiry
JWT_EXPIRE=30d

# Node environment
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://alex-store.vercel.app,https://www.alexstore.com
CLIENT_URL=https://your-frontend.vercel.app

# Seed user credentials — used when the database is empty on first run
# Change these before first deployment in production
SEED_ADMIN1_EMAIL=admin@alexstore.com
SEED_ADMIN1_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SEED_ADMIN2_EMAIL=tolgi@alexstore.com
SEED_ADMIN2_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SEED_CUSTOMER_EMAIL=customer@alexstore.com
SEED_CUSTOMER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Force re-seed on next startup (wipes all data — use with caution)
# FORCE_SEED=true

# Cloudinary (optional — for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payment gateway credentials (leave empty to use mock payments in dev)
# TELEBIRR_API_KEY=
# TELEBIRR_MERCHANT_ID=
# CBE_BIRR_API_KEY=
